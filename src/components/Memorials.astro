---
import { Picture } from 'astro:assets';
import relief from '../../images/legacy/200000145-img-20240813-084401-748.jpeg';
import stele from '../../images/legacy/200000083-img-8126.jpeg';
import plaque from '../../images/legacy/200000094-img-20200726-121357.jpeg';

const memorials = [
  {
    image: relief,
    className: 'relief',
    alt: 'Бронзовый барельеф: мурза Сабанак в полный рост рядом с родовым гербом',
    place: 'Тобольск, 2024',
    title: 'Барельеф мурзы Сабанака',
    text: 'Работа скульптора Сергея Титлинова на площади почётных граждан. Первый такой барельеф в Тюменской области, посвящённый знаковым фигурам татарского народа.',
  },
  {
    image: stele,
    className: 'stele',
    alt: 'Чёрная памятная стела с гербом и надписью «мурзы Кульмаметьевы, 1796 г.» на заснеженном поле',
    place: 'Сабанаки, 2017',
    title: 'Памятная стела',
    text: 'Мусульманская стела возле родового имения.',
  },
  {
    image: plaque,
    className: 'plaque',
    alt: 'Информационная табличка на въезде в деревню Сабанаки',
    place: 'Сабанаки, 2020',
    title: 'Табличка в деревне',
    text: 'Дата основания и краткая история на татарском и русском языках.',
  },
];
---

<section id="memory" class="memory">
  <div class="wrap">
    <p class="label">Память</p>
    <h2>Памятные места</h2>

    <ul>
      {
        memorials.map((item) => (
          <li class={item.className}>
            <Picture
              src={item.image}
              formats={['avif', 'webp']}
              widths={[420, 720, 1080]}
              sizes="(max-width: 700px) 92vw, 45vw"
              alt={item.alt}
            />
            <p class="place">{item.place}</p>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .memory {
    padding-block: var(--section);
    background: var(--paper-deep);
  }

  h2 {
    margin-top: 1rem;
  }

  ul {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1fr);
    gap: clamp(2rem, 4vw, 3.5rem);
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }

  .relief {
    grid-row: span 2;
  }

  .relief :global(img) {
    aspect-ratio: 4 / 4.4;
    object-fit: cover;
  }

  .stele :global(img),
  .plaque :global(img) {
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }

  .stele :global(img) {
    object-position: 50% 28%;
  }

  .place {
    margin-top: 1rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--gold-deep);
  }

  h3 {
    margin-top: 0.25rem;
    font-size: clamp(1.4rem, 2vw, 1.75rem);
  }

  h3 + p {
    max-width: 36em;
    margin-top: 0.4rem;
    color: var(--muted);
  }

  @media (max-width: 700px) {
    ul {
      grid-template-columns: minmax(0, 1fr);
    }

    .relief {
      grid-row: auto;
    }
  }
</style>
